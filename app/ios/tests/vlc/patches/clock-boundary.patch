+bool input_clock_GetRateBoundary( input_clock_t *cl, vlc_tick_t date,
+    int old_rate, int new_rate, vlc_tick_t *boundary )
+{
+    bool found = false;
+    vlc_mutex_lock( &cl->lock );
+    for( size_t i = 1; i < cl->presentation.count; ++i )
+    {
+        const animeko_rate_segment *s = &cl->presentation.segments[i];
+        if( s->system <= date && s->rate == new_rate &&
+            cl->presentation.segments[i - 1].rate == old_rate )
+        {
+            *boundary = s->system;
+            found = true;
+        }
+    }
+    vlc_mutex_unlock( &cl->lock );
+    return found;
+}
