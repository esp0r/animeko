+unsigned picture_fifo_Retime(picture_fifo_t *fifo, vlc_tick_t boundary, int old_rate, int new_rate)
+{
+    unsigned count = 0;
+    vlc_mutex_lock(&fifo->lock);
+    for (picture_t *picture = fifo->first; picture; picture = picture->p_next) {
+        if (picture->date >= boundary) ++count;
+        picture->date = animeko_rate_retime(picture->date, boundary, old_rate, new_rate);
+    }
+    vlc_mutex_unlock(&fifo->lock);
+    return count;
+}
